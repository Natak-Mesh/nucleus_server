[Unit]
Description=Nucleus Server Info Web App
After=network.target

[Service]
Type=simple
User=natak
WorkingDirectory=/opt/nucleus-webapp
ExecStart=/opt/nucleus-webapp/.venv/bin/python /opt/nucleus-webapp/app.py
Restart=on-failure
RestartSec=3
# Allow binding privileged port 80 without full root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# Load per-unit secrets (ADMIN_PIN, MUMBLE_SUPERUSER_PW). systemd reads this as
# root before dropping to the User= account, so the values reach the app
# without the file being world-readable. '-' => start even if missing.
EnvironmentFile=-/etc/nucleus/secrets
# NOTE: NoNewPrivileges is intentionally NOT set — the admin zone uses a
# tightly-scoped 'sudo systemctl' (see /etc/sudoers.d/nucleus-webapp), which
# NoNewPrivileges would block.

[Install]
WantedBy=multi-user.target
